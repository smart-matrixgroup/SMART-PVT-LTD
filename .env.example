# Firebase project config — copy this file to ".env" and fill in the
# values from Firebase Console > Project Settings > General > Your apps
# (Web app) > SDK setup and configuration > Config.
#
# .env is already in .gitignore — never commit real keys.
# These VITE_* values are safe to ship in the client bundle; Firebase
# web API keys identify the project, they are not secrets. Actual
# access control is enforced by firestore.rules, not by hiding this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
