rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public Lead creation from Quotation and Contact forms
    match /leads/{leadId} {
      allow create: if request.resource.data.name != null 
                    && request.resource.data.whatsapp != null;
      allow read, update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Public catalog content read-only
    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Client portal data strictly authenticated
    match /clients/{clientId} {
      allow read, write: if request.auth != null && request.auth.uid == clientId;
    }
  }
}

