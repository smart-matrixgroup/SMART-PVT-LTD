rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Role is resolved by document existence rather than Firebase custom
    // claims, since this project has no Cloud Functions/Admin SDK backend
    // to mint claims. See src/context/AuthContext.jsx for the client side.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin membership list — never created/edited from the client.
    // Provision new admins manually from the Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public Lead creation from Quotation and Contact forms
    match /leads/{leadId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.whatsapp is string
                    && request.resource.data.whatsapp.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    // Public catalog content read-only
    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Client portal data: the client can read (not write) their own
    // record; only an admin can create/update/delete client records.
    match /clients/{clientId} {
      allow read: if request.auth != null && request.auth.uid == clientId;
      allow write: if isAdmin();
    }
  }
}

