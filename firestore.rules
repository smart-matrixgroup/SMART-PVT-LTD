rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Role is resolved by document existence rather than Firebase custom
    // claims, since this project has no Cloud Functions/Admin SDK backend
    // to mint claims. See src/context/AuthContext.jsx for the client side.
    // Keep this email list identical to storage.rules → isAdmin(), otherwise
    // an admin can upload files but gets "Missing or insufficient permissions"
    // on every Firestore write (e.g. creating a portfolio link).
    function isAdmin() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.email == 'admin@smart.com' ||
         request.auth.token.email == 'admin@findmysmart.com');
    }

    // Admin membership list — never created/edited from the client.
    // Provision new admins manually from the Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public Lead creation from the website forms (quote request, contact,
    // get-started, newsletter). Require a non-empty name plus at least one
    // way to reach the person — phone/WhatsApp (most forms) or email
    // (newsletter has no phone).
    match /leads/{leadId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && (
                      (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() > 0)
                      || (request.resource.data.email is string && request.resource.data.email.size() > 0)
                    );
      allow read, update, delete: if isAdmin();
    }

    // Public catalog content read-only
    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Client portal data: the client can read (not write) their own
    // record; admins read AND write everything (ERP Clients page,
    // dashboard stats). Without isAdmin() on read the ERP dashboard's
    // clients listener fails with permission-denied for admins.
    match /clients/{clientId} {
      allow read: if isAdmin() ||
        (request.auth != null && request.auth.uid == clientId);
      allow write: if isAdmin();
    }

    // Projects: the client portal reads its own projects, submits new
    // project requests, and flags acceptance / advance-paid on them.
    // The client can never reassign a project to another client.
    match /projects/{projectId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow create: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.clientId == request.auth.uid);
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.clientId == request.auth.uid &&
         request.resource.data.clientId == resource.data.clientId);
      allow delete: if isAdmin();
    }

    // Portfolio request links (ERP → Clients → Portfolio Link). The token in
    // the URL is the only access control the public form has, so anyone may
    // GET one link by its exact id (the form validates it), but listing all
    // links or creating/turning them off stays admin-only.
    match /portfolioLinks/{token} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Submissions from those links. The public form creates a request with a
    // name plus a way to reach the person; only admins read them or mark them
    // as converted into a client.
    match /portfolioRequests/{requestId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && (
                      (request.resource.data.phone is string && request.resource.data.phone.size() > 0)
                      || (request.resource.data.email is string && request.resource.data.email.size() > 0)
                    );
      allow read, update, delete: if isAdmin();
    }


    match /messages/{projectId}/chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    // Phase 4: Real Messaging System (Admin <-> Staff and Admin <-> Client).
    // Client threads additionally allow the staff assigned to that client
    // (conversations/<id>.assignedStaffUids, written by admins when work is
    // assigned) to read the thread and post messages to the client.
    match /conversations/{convId} {
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.participantUid == request.auth.uid ||
        ('assignedStaffUids' in resource.data && request.auth.uid in resource.data.assignedStaffUids)));
      allow create: if isAdmin() || (request.auth != null && request.resource.data.participantUid == request.auth.uid);
      allow update: if isAdmin() || (request.auth != null && (
        resource.data.participantUid == request.auth.uid ||
        ('assignedStaffUids' in resource.data && request.auth.uid in resource.data.assignedStaffUids)));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // The fixed conversation-ID checks make collection queries provable
        // for rules (a query on conversations/admin_staff_<uid>/messages must
        // be allowed for the whole path). Without them Firestore rejects the
        // listener with "Missing or insufficient permissions" even though
        // every individual message has the right receiverId.
        allow read: if isAdmin() || (request.auth != null && (
          convId == 'admin_staff_' + request.auth.uid ||
          convId == 'admin_client_' + request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          resource.data.senderId == request.auth.uid ||
          ('assignedStaffUids' in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data
           && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.assignedStaffUids)));
        allow create: if isAdmin() || (request.auth != null &&
          request.resource.data.senderId == request.auth.uid && (
          request.resource.data.receiverRole == 'admin' ||
          ('assignedStaffUids' in get(/databases/$(database)/documents/conversations/$(convId)).data
           && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.assignedStaffUids)));
        allow update: if isAdmin() || (request.auth != null && resource.data.receiverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
        allow delete: if isAdmin();
      }
    }

    // ── ERP: quotation & requirement templates, quotations, payments ──
    // Templates are the master data admins edit; quotations / client
    // requirements / payments COPY template content at creation time, so
    // later template edits never change existing records.

    match /quotationTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /requirementTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Client requirement checklists (copied from requirementTemplates)
    match /requirements/{requirementId} {
      allow read, write: if isAdmin();
    }

    // Requirement FORMS sent to clients (built-in per-service forms and
    // admin-built custom forms). Admin sends (create) and reviews; the
    // client may read their own forms and submit answers — but ONLY the
    // answers/status/filledAt fields, never re-address or re-type the form.
    match /requirementForms/{formId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.clientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['answers', 'status', 'filledAt']));
    }

    // Quotations: admins manage everything. The client may read their own
    // quotations and may ONLY flip status to/from Accepted (plus stamp
    // acceptedAt) — never touch money fields or payments data.
    match /quotations/{quotationId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.clientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'acceptedAt', 'updatedAt']));
    }

    // Payments (each payment embeds its unique receiptNo — there is no
    // separate receipts collection). Client can read only their own payments.
    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Sequence counters for unique quotation / receipt / staff-ID numbers
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ── Phase 3: Staff portal ──────────────────────────────────────
    // Staff documents use the Firebase Auth uid as the doc id, so
    // ownership is enforced by the doc id itself.

    // Staff profiles. A staff member can read their own profile and may
    // only manage their own `docs` array (portal KYC / Certificates pages
    // — the matching Storage object must already exist under
    // staff-docs/{uid}/). The profile itself — name, phone, address,
    // photo, department, salary, login email, deleted flag — is
    // admin-managed only; staff cannot edit their own record.
    // `deleted: true` blocks portal login (see AuthContext.jsx) — a
    // soft delete, never a hard removal when attendance/salary records
    // exist.
    //
    // Login email change (src/staff/loginEmail.js): the admin stages
    // pendingLoginEmail, then the signed-in owner applies it. Firebase only
    // lets a user move their OWN auth email and there is no Admin SDK here,
    // so the write is split the same way. This branch accepts nothing but
    // the address already staged by the admin — a staff member still cannot
    // rename themselves to anything they choose.
    match /staff/{uid} {
      allow read: if isAdmin() ||
        (request.auth != null && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['docs', 'updatedAt'])) ||
        (request.auth != null && request.auth.uid == uid &&
         'pendingLoginEmail' in resource.data &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['loginEmail', 'email', 'pendingLoginEmail', 'pendingLoginEmailAt', 'emailChangeLog', 'updatedAt']) &&
         resource.data.pendingLoginEmail == request.resource.data.loginEmail &&
         request.resource.data.loginEmail == request.resource.data.email);
    }

    // Work assignments. Staff read their own (authUid field) and may ONLY
    // move them along the lifecycle: status, progress, timestamps. They
    // can never reassign themselves to another project/staff or change
    // deadlines/priority. The client is given read access to assignments
    // carrying their own clientId (embedded by the admin when the work is
    // assigned) so "who is working on my project, and how far" is visible
    // in the client portal — never writable by anyone outside admin.
    match /workAssignments/{assignmentId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.authUid == request.auth.uid) ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.authUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'progress', 'updatedAt', 'startedAt']));
    }

    // Staff-maintained Work Progress list (portal → Work Progress). Each
    // stage is added by the staff member themselves and carries the photo /
    // PDF proof paths for the work they finished. Admins read every item
    // (Staff → profile → Work Progress, Work → Work Stages) and approve each
    // finished stage; only an APPROVED stage becomes readable by that stage's
    // client in their portal. Proof files stay staff-private Storage.
    match /staffProgress/{itemId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.staffUid == request.auth.uid) ||
        (request.auth != null &&
         resource.data.clientId == request.auth.uid &&
         resource.data.reviewState == 'accepted');
      allow create: if isAdmin() ||
        (request.auth != null && request.resource.data.staffUid == request.auth.uid);
      // Staff own their row, but the approval stamp belongs to the admin: a
      // staff update can never set reviewState to 'accepted' themselves.
      allow update: if isAdmin() ||
        (request.auth != null && resource.data.staffUid == request.auth.uid &&
         (request.resource.data.reviewState != 'accepted' ||
          resource.data.reviewState == 'accepted'));
      allow delete: if isAdmin() ||
        (request.auth != null && resource.data.staffUid == request.auth.uid);
    }

    // Attendance. Staff create/update only their own records (the portal
    // check-in/out). The update is NOT field-restricted because checkout /
    // auto-close legitimately stamps hoursMins/status/autoClosed — but the
    // authUid can never change hands.
    match /attendance/{attendanceId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.authUid == request.auth.uid);
      allow create: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.authUid == request.auth.uid);
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.authUid == request.auth.uid &&
         request.resource.data.authUid == resource.data.authUid);
      allow delete: if isAdmin();
    }

    // Daily work updates. Staff submit their own; admins monitor all.
    match /dailyUpdates/{updateId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.authUid == request.auth.uid);
      allow create: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.authUid == request.auth.uid);
      allow update: if isAdmin() ||
        (request.auth != null && resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Salary payments / payslips. Staff read ONLY their own payslips;
    // every write is admin-only (money is never client-writable).
    match /salaryPayments/{paymentId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.authUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Advance-payment receipt proofs. The client uploads a payment
    // screenshot/slip photo against their own quotation; only admins may
    // verify/reject (update) or delete. A client can never forge another
    // client's proof — clientId must equal their own uid.
    match /paymentProofs/{proofId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Invoices (Invoice Centre). Admin manages everything; a client may
    // read only their own invoices (portal → Invoices tab).
    match /invoices/{invoiceId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Report requests — the admin "sends" a pre-filled DAILY WORK LOG sheet
    // to a staff member (one doc per staff + period). The staff member reads
    // their own requests and may ONLY stamp the return: status + the
    // returned-file metadata (never the period, range or staff identity).
    // Admin creates/deletes and can also mark a return approved.
    match /reportRequests/{requestId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.staffUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.staffUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'returnedPath', 'returnedName', 'returnedSize', 'returnedAt', 'updatedAt']));
    }

    // Leave applications. A staff member files their own letter from the
    // portal (staff-docs/{uid}/leave_….png holds the painted paper); the
    // admin reviews and decides. The decision is APPENDED to `history`, so
    // nobody rewrites an application after the fact:
    //   • staff create only their own, always starting as Pending;
    //   • staff may edit their own only while it is still Pending, and never
    //     touch the decision fields;
    //   • only the admin sets status / adminNote / reviewedBy / reviewedAt.
    match /leaves/{leaveId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.staffUid == request.auth.uid);

      allow create: if request.auth != null &&
        (isAdmin() || request.resource.data.staffUid == request.auth.uid) &&
        request.resource.data.status == 'Pending';

      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.staffUid == request.auth.uid &&
         request.resource.data.staffUid == resource.data.staffUid &&
         resource.data.status == 'Pending' &&
         request.resource.data.status == 'Pending' &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['status', 'adminNote', 'reviewedBy', 'reviewedAt', 'staffUid', 'staffName']));

      allow delete: if isAdmin() ||
        // A staff member may withdraw — and remove — an application that is
        // still Pending, so a test record they filed can be cleaned up from
        // their own portal. Once the admin has decided, only the admin deletes.
        (request.auth != null &&
         resource.data.staffUid == request.auth.uid &&
         resource.data.status == 'Pending');
    }

    // Finance module — income and expenses (admin only by default).
    // NOTE: Rules must be deployed manually for these collections to work live.
    match /financeIncome/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /financeExpenses/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Weekly report email ledger. The Cloud Function (Admin SDK) writes these
    // rows; the ERP only reads them to show what was sent, to whom, and who
    // filed nothing. Nobody but an admin can see or change the post.
    match /weeklyReportRuns/{runId} {
      allow read, write: if isAdmin();
    }

    // Optional retarget for the weekly mails — { to, from, cc, enabled }.
    // Admin edits it in the ERP; the function reads it with Admin SDK.
    // The Gmail app password is NOT stored here (it lives in Functions
    // Secrets Manager), so this doc can never leak the SMTP key.
    match /reportEmailConfig/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Job offer letters. Admin-only: each letter carries a candidate's
    // salary and personal address, and only the admin drafts/edits them.
    match /offerLetters/{letterId} {
      allow read, write: if isAdmin();
    }

    // System Settings & Access Control Rules
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}

