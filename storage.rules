rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same role model as firestore.rules — admins/{uid} doc existence,
    // no custom claims. NOTE: the firestore.exists() cross-service lookup is
    // NOT honoured on this project's Storage rules (verified 2026-10-14: an
    // account with a real admins/{uid} doc still gets denied), so the email
    // allow-list is the branch that actually grants admins access here.
    // Keep the exists() check too (harmless, may work in future) and list
    // every real admin email below.
    function isAdmin() {
      return request.auth != null &&
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.email == 'admin@smart.com' ||
         request.auth.token.email == 'admin@findmysmart.com');
    }

    // Staff HR / KYC / certificate documents, organised by the staff
    // member's Firebase Auth uid so rules can enforce ownership.
    //
    // These files are NEVER served through public download URLs — the app
    // reads them with the Firebase SDK (getBytes), which enforces these
    // rules on every single download. No getDownloadURL() anywhere.
    match /staff-docs/{authUid}/{fileName} {
      // Only the owning staff member and admins may read a document.
      allow read: if request.auth != null &&
        (request.auth.uid == authUid || isAdmin());

      // Uploads: admin (on behalf of staff) or the staff member
      // themselves. Images and PDFs only, max 10 MB.
      allow create, update: if request.auth != null &&
        (request.auth.uid == authUid || isAdmin()) &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('application/pdf'));

      allow delete: if isAdmin();
    }

    // Client requirement-form uploads (bank statements, reference files
    // etc.), organised as requirement-files/{clientUid}/{formId}/{fileName}
    // so ownership maps to the Firebase Auth uid like staff-docs.
    // The client stores the download URL in their form answers; reading
    // via the SDK still enforces these rules on every download.
    match /requirement-files/{authUid}/{formId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == authUid || isAdmin());

      // Uploads: the owning client or an admin. Images, PDFs and common
      // office documents, max 10 MB (matches the form builder's
      // FILE_ACCEPTS options: any / pdf / image / doc / excel / pdf_image / all_docs).
      allow create, update: if request.auth != null &&
        (request.auth.uid == authUid || isAdmin()) &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('application/msword') ||
         request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
         request.resource.contentType.matches('application/vnd.ms-excel') ||
         request.resource.contentType.matches('text/plain') ||
         request.resource.contentType == 'application/octet-stream');

      allow delete: if request.auth != null &&
        (request.auth.uid == authUid || isAdmin());
    }

    // Advance-payment receipt photos uploaded by clients, organised as
    // payment-proofs/{clientUid}/{quotationId}/{fileName} so the folder
    // name enforces ownership (same pattern as requirement-files).
    // Images only — these are payment screenshot/slip photos.
    match /payment-proofs/{authUid}/{quotationId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == authUid || isAdmin());

      allow create: if request.auth != null &&
        request.auth.uid == authUid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow delete: if isAdmin();
    }

    // Filled "DAILY WORK LOG" sheets sent back by staff for a report
    // request, organised as report-sheets/{staffUid}/{requestId}/{fileName}
    // so the folder name enforces ownership (same pattern as
    // requirement-files). The admin can read every returned sheet; the
    // owning staff member can read/replace their own return. Only the staff
    // member uploads (the admin never writes into a staff folder).
    match /report-sheets/{authUid}/{requestId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == authUid || isAdmin());

      allow create, update: if request.auth != null &&
        request.auth.uid == authUid &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
         request.resource.contentType.matches('application/vnd.ms-excel') ||
         request.resource.contentType == 'text/csv' ||
         request.resource.contentType == 'application/octet-stream');

      allow delete: if isAdmin();
    }

    // Saved quotation letterhead images ("Save to quotation" in the Image
    // Studio), organised as quotation-renders/{quotationId}/{fileName}.
    // The quotation doc stores the download URL, so the client can open it.
    match /quotation-renders/{quotationId}/{fileName} {
      allow read: if request.auth != null && isAdmin();

      allow create, update: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow delete: if isAdmin();
    }

    // No other match block → every other path is denied by default.
  }
}
