# Copy to functions/.env and fill in — never commit the real file.
#
# Meta WhatsApp Cloud API (free tier). Create at developers.facebook.com →
# WhatsApp → API setup. Use the permanent token of a system user, not the
# 24-hour test token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# The 15:30 confirmation and the payroll alert are business-initiated messages,
# so outside a 24-hour chat window Meta only accepts approved TEMPLATES. Create
# two utility templates with these bodies and put their names in the ERP
# (Team → WhatsApp Alerts → Settings):
#   checkin_confirmation : "Dear {{1}}, your attendance for {{2}} has been recorded. Please submit your daily work report on the staff portal."
#   salary_pending       : "SMART payroll alert for {{1}}: {{2}} staff member(s) still not marked — {{3}}."
# Leave the template names blank to send plain text (works only inside an
# open chat window; anything else is kept in the ERP as a one-tap wa.me link).
